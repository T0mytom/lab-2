<div class="container my-4">
  <h1><%= @post.title %></h1>
  <p><%= @post.content %></p>
  <% if @post.user %>
    <p><strong>Author:</strong> <%= @post.user.email %></p>
  <% else %>
    <p><strong>Author:</strong> Unknown</p>
  <% end %>
  <p><strong>Published:</strong> <%= @post.published %></p>

  <h2 class="my-4">Comments</h2>
  <% if @post.comments.any? %>
    <ul class="list-group">
      <% @post.comments.each do |comment| %>
        <li class="list-group-item">
          <p><strong><%= comment.author_name %>:</strong> <%= comment.content %></p>

          <% if can?(:edit, comment) %>
            <%= link_to 'Edit', edit_post_comment_path(@post, comment), class: 'btn btn-sm btn-warning' %>
          <% end %>

          <% if can?(:destroy, comment) %>
            <%= link_to 'Delete', post_comment_path(@post, comment), method: :delete, data: { confirm: "Are you sure?" }, class: 'btn btn-sm btn-danger' %>
          <% end %>

        </li>
      <% end %>
    </ul>
  <% else %>
    <p>No comments yet.</p>
  <% end %>

  <h3>Add a comment</h3>
  <% if user_signed_in? %>
    <%= form_with(model: [ @post, @post.comments.build ], local: true) do |form| %>
      <div class="form-group">
        <%= form.text_area :content, class: "form-control", placeholder: "Your comment..." %>
      </div>
      <%= form.submit "Post Comment", class: "btn btn-primary" %>
    <% end %>
  <% else %>
    <p>You must be <%= link_to "logged in", new_user_session_path %> to add a comment.</p>
  <% end %>

  <%= link_to 'Back to Posts', posts_path, class: 'btn btn-secondary' %>
</div>
