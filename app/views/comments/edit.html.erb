<h2>Edit Comment</h2>

<%= form_with(model: [ @post, @comment ], local: true) do |form| %>
  <div class="field">
    <%= form.label :content, "Comment" %><br />
    <%= form.text_area :content, value: @comment.content, class: "form-control" %>
  </div>

  <div class="actions">
    <%= form.submit "Update Comment", class: "btn btn-primary" %>
  </div>
<% end %>

<%= link_to 'Back', post_path(@post), class: 'btn btn-secondary' %>
